# Variáveis de ambiente do processo; não há carregamento automático de .env.
# Desktop gera AYLA_TOKEN e AYLA_PORT internamente.
AYLA_LOCAL_ENABLED=true
# Sem modelo obrigatório. Configuração automática por instalação virá depois.
AYLA_LOCAL_MODEL=
AYLA_LOCAL_URL=http://127.0.0.1:11434
# Cloud é fallback opcional. Envia somente a mensagem atual quando permitido.
AYLA_CLOUD_ENABLED=false
AYLA_CLOUD_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# AYLA_DB_PATH=/caminho/absoluto/ayla_memory.db
