{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ayla",
  "version": "0.1.0",
  "identifier": "dev.feit.ayla",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ayla",
        "width": 420,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/ayla-backend"],
    "resources": ["bin/ayla-backend.exe"]
  }
}
